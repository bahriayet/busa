{
  "name": "busa-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend MAHA Dewi Laundry Ops — Fastify + Neon PostgreSQL, event-sourced floor state",
  "license": "MIT",
  "homepage": "https://github.com/bahriayet/busa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahriayet/busa.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/bahriayet/busa/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  }
}
