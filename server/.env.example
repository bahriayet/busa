# Salin ke `.env` lalu isi nilainya. Jangan commit `.env` yang asli.

# Wajib — connection string Neon (pooler).
BUSA_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Opsional
# BUSA_HOST=127.0.0.1
# BUSA_PORT=8080
# BUSA_JWT_SECRET=          # min 32 karakter; jika kosong dibuat otomatis di data/.jwt-secret
# BUSA_JWT_TTL=12h
# BUSA_SEED_PASSWORD=busa1234
# BUSA_SIMULATE=true
# BUSA_TICK_MS=7000
# BUSA_CORS_ORIGINS=        # daftar origin dipisah koma; kosong = tolak lintas origin
# BUSA_LOG_LEVEL=info
# BUSA_RATE_LIMIT_MAX=300        # request global per menit per IP
# BUSA_RATE_LIMIT_LOGIN_MAX=20   # percobaan login/register/reset per 15 menit per IP
# BUSA_TRUST_PROXY=false         # otomatis true bila env PORT ada (host PaaS/Render)
# BUSA_SERVE_STATIC=true
# BUSA_STATIC_ROOT=         # default: root project (folder frontend)
# BUSA_DATA_DIR=data
